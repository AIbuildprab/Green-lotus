# Same Resend account can be used for multiple domains.
RESEND_API_KEY=

# Where estimate requests are delivered (defaults to greenlotuslandscapes@gmail.com)
QUOTE_TO_EMAIL=greenlotuslandscapes@gmail.com

# Must be an address on a domain verified in Resend
QUOTE_FROM_EMAIL=Green Lotus Landscape <quotes@greenlotuslandscapes.ca>
